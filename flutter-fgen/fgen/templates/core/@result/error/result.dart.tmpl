import 'failure.dart';

export 'failure.dart';

/// Either a value ([Ok]) or a [Failure] ([Err]). Use a `switch` to handle both.
sealed class Result<T> {
  const Result();
}

final class Ok<T> extends Result<T> {
  const Ok(this.value);

  final T value;
}

final class Err<T> extends Result<T> {
  const Err(this.failure);

  final Failure failure;
}
