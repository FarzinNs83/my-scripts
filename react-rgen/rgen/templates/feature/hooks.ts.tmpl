export function useCreate{{ n.pascal }}() {
  const queryClient = useQueryClient()
  return useMutation({
    mutationFn: (input: {{ n.pascal }}Input) => {{ n.camel }}Api.create(input),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: {{ n.camel }}Keys.lists() }),
