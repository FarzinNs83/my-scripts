export function useUpdate{{ n.pascal }}() {
  const queryClient = useQueryClient()
  return useMutation({
    mutationFn: ({ id, input }: { id: Id; input: Partial<{{ n.pascal }}Input> }) => {{ n.camel }}Api.update(id, input),
    onSuccess: (data, { id }) => {
      queryClient.setQueryData({{ n.camel }}Keys.detail(id), data)
      return queryClient.invalidateQueries({ queryKey: {{ n.camel }}Keys.lists() })
