  lists: () => [...{{ n.camel }}Keys.all, 'list'] as const,
  list: (params?: ListParams) => [...{{ n.camel }}Keys.lists(), params ?? {}] as const,
  details: () => [...{{ n.camel }}Keys.all, 'detail'] as const,
  detail: (id: Id) => [...{{ n.camel }}Keys.details(), id] as const,
}

export function use{{ p.pascal }}(params?: ListParams) {
  return useQuery({
