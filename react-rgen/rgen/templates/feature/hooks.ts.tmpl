  return useMutation({
    mutationFn: (id: Id) => {{ n.camel }}Api.remove(id),
    onSuccess: (_data, id) => {
      queryClient.removeQueries({ queryKey: {{ n.camel }}Keys.detail(id) })
      return queryClient.invalidateQueries({ queryKey: {{ n.camel }}Keys.lists() })
